{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gujoai/dns-appliance-provisioning/schemas/enrollment-record.schema.json",
  "title": "DNS appliance public enrollment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "hostname",
    "role",
    "address",
    "hardware",
    "installer",
    "ssh_host_key_fingerprints",
    "health",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generation_id": { "type": "string", "minLength": 1 },
    "hostname": { "enum": ["dns01", "dns02", "dns03"] },
    "role": { "enum": ["primary", "secondary"] },
    "address": { "type": "string", "pattern": "^10\\.0\\.5\\.[123]$" },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_name", "product_number", "system_serial", "system_uuid", "mac", "disk_model", "disk_serial"],
      "properties": {
        "product_name": { "type": "string" },
        "product_number": { "type": "string" },
        "system_serial": { "type": "string" },
        "system_uuid": { "type": "string" },
        "mac": { "type": "string" },
        "disk_model": { "type": "string" },
        "disk_serial": { "type": "string" }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "image_sha256"],
      "properties": {
        "build_id": { "type": "string" },
        "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ssh_host_key_fingerprints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "certificate_fingerprints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns_udp", "dns_tcp", "technitium", "cockpit"],
      "properties": {
        "dns_udp": { "const": "healthy" },
        "dns_tcp": { "const": "healthy" },
        "technitium": { "const": "healthy" },
        "cockpit": { "const": "healthy" }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
