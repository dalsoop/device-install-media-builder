#!/bin/bash
set -euo pipefail

image=
device=
confirmation=

usage() {
    cat >&2 <<'EOF'
usage: sudo usb-media/write-image-macos \
  --image /absolute/path/device-os.raw \
  --device /dev/diskN \
  --confirm 'ERASE /dev/diskN MEDIA_NAME EXACT_BYTES'

The raw image must have exactly the same byte size as the removable target.
The command erases the entire target, performs a byte-for-byte readback, and
ejects the device only after verification succeeds.
EOF
    exit 2
}

fail() {
    echo "write-image-macos: $*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --image) image=${2:-}; shift 2 ;;
        --device) device=${2:-}; shift 2 ;;
        --confirm) confirmation=${2:-}; shift 2 ;;
        *) usage ;;
    esac
done

[ "$(uname -s)" = Darwin ] || fail "macOS is required"
[ "$(id -u)" -eq 0 ] || fail "run with sudo"
[[ "$image" = /* ]] || fail "--image must be an absolute path"
[ -f "$image" ] || fail "raw image not found: $image"
[[ "$device" =~ ^/dev/disk[0-9]+$ ]] || fail "whole-disk /dev/diskN target required"

info=$(mktemp /tmp/device-os-disk-info.XXXXXX)
cleanup() {
    rm -f "$info"
}
trap cleanup EXIT HUP INT TERM

diskutil info -plist "$device" > "$info" || fail "cannot inspect $device"
plist_value() {
    plutil -extract "$1" raw -o - "$info"
}

[ "$(plist_value WholeDisk)" = true ] || fail "whole-disk target required"
[ "$(plist_value Internal)" = false ] || fail "refusing an internal disk"
[ "$(plist_value Removable)" = true ] || fail "target is not removable"
[ "$(plist_value WritableMedia)" = true ] || fail "target is not writable"
[ "$(plist_value VirtualOrPhysical)" = Physical ] || fail "target is not physical media"

media_name=$(plist_value MediaName)
device_bytes=$(plist_value TotalSize)
image_bytes=$(stat -f %z "$image")
[ "$image_bytes" = "$device_bytes" ] ||
    fail "image and target sizes differ: image=$image_bytes target=$device_bytes"

expected="ERASE $device $media_name $device_bytes"
[ "$confirmation" = "$expected" ] ||
    fail "exact confirmation required: $expected"

echo "target: $device"
echo "media: $media_name"
echo "bytes: $device_bytes"
echo "warning: all existing partitions and data will be erased"

diskutil unmountDisk "$device"
raw_device=/dev/r${device#/dev/}
dd if="$image" of="$raw_device" bs=4m
sync
cmp -n "$image_bytes" "$image" "$raw_device"
diskutil eject "$device"

echo "write-image-macos: byte-for-byte verification passed and $device was ejected"
