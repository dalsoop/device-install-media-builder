{
  "schema_version": 1,
  "product": {
    "name": "Homelab Bootstrap USB",
    "repository": "https://github.com/dalsoop/homelab-bootstrap-media"
  },
  "usb": {
    "data_label": "HOMELAB-USB",
    "enrollment_label": "DNS-ENROLL",
    "enrollment_reserve_mib": 2048,
    "capacity_overhead_mib": 768,
    "default_language": "ko_KR"
  },
  "bootloader": {
    "id": "ventoy",
    "implementation": "ventoy",
    "version": "1.1.18",
    "archive_root": "ventoy-1.1.18",
    "source": {
      "kind": "locked-download",
      "filename": "ventoy-1.1.18-linux.tar.gz",
      "url": "https://github.com/ventoy/Ventoy/releases/download/v1.1.18/ventoy-1.1.18-linux.tar.gz",
      "sha256": "d86ff9de63d94c8b8f1f6b14d23c55af4b88e8207bf2893890892a6a97b1ad54"
    }
  },
  "groups": [
    { "id": "dns", "path": "images/01-dns", "menu_alias": "01 DNS 서버" },
    { "id": "virtualization", "path": "images/02-virtualization", "menu_alias": "02 가상화 및 백업" },
    { "id": "storage", "path": "images/03-storage", "menu_alias": "03 스토리지" },
    { "id": "desktop", "path": "images/04-desktop", "menu_alias": "04 데스크톱" },
    { "id": "tools", "path": "images/90-tools", "menu_alias": "90 점검 및 복구" }
  ],
  "entries": [
    {
      "id": "dns-appliance",
      "group": "dns",
      "destination": "images/01-dns/dns-appliance-installer.iso",
      "menu_alias": "DNS 서버 자동 설치 (HP 전용, 디스크 삭제 주의)",
      "description_ko": "정확한 HP 인벤토리와 재설치 승인이 일치해야만 디스크 삭제를 허용한다.",
      "description_en": "Guarded DNS installer; exact HP inventory and reinstall authorization are required.",
      "boot_behavior": "guarded-unattended",
      "profile_adapter": "dns-appliance",
      "source": {
        "kind": "runtime-artifact",
        "manifest_digest_field": "iso_sha256",
        "manifest_destination": "manifests/dns-build-manifest.json"
      }
    },
    {
      "id": "proxmox-ve",
      "group": "virtualization",
      "version": "9.2-1",
      "destination": "images/02-virtualization/proxmox-ve-9.2-1.iso",
      "menu_alias": "Proxmox VE 9.2-1 대화형 설치",
      "description_ko": "가상화 호스트용 대화형 설치기이며 대상 디스크를 직접 확인한다.",
      "description_en": "Interactive virtualization-host installer; verify the destination disk manually.",
      "boot_behavior": "interactive-installer",
      "profile_adapter": "none",
      "source": {
        "kind": "locked-download",
        "filename": "proxmox-ve_9.2-1.iso",
        "url": "https://enterprise.proxmox.com/iso/proxmox-ve_9.2-1.iso",
        "sha256": "4e88fe416df9b527624a175f24c9aa07c714d3332afb1ee3dbf3879573ef2c6c"
      }
    },
    {
      "id": "proxmox-backup-server",
      "group": "virtualization",
      "version": "4.2-1",
      "destination": "images/02-virtualization/proxmox-backup-server-4.2-1.iso",
      "menu_alias": "Proxmox Backup Server 4.2-1 대화형 설치",
      "description_ko": "Proxmox 백업 서버용 대화형 설치기이며 대상 디스크를 직접 확인한다.",
      "description_en": "Interactive Proxmox backup-server installer; verify the destination disk manually.",
      "boot_behavior": "interactive-installer",
      "profile_adapter": "none",
      "source": {
        "kind": "locked-download",
        "filename": "proxmox-backup-server_4.2-1.iso",
        "url": "https://enterprise.proxmox.com/iso/proxmox-backup-server_4.2-1.iso",
        "sha256": "2fb299deac3929253712c9c3dfc9237edbe70af83c8848467616b771a1d5453e"
      }
    },
    {
      "id": "truenas-scale",
      "group": "storage",
      "version": "25.10.7",
      "destination": "images/03-storage/truenas-25.10.7.iso",
      "menu_alias": "TrueNAS SCALE 25.10.7 대화형 설치",
      "description_ko": "스토리지 서버용 대화형 설치기이며 대상 디스크를 직접 확인한다.",
      "description_en": "Interactive storage-server installer; verify the destination disk manually.",
      "boot_behavior": "interactive-installer",
      "profile_adapter": "none",
      "source": {
        "kind": "locked-download",
        "filename": "TrueNAS-SCALE-25.10.7.iso",
        "url": "https://download.truenas.com/TrueNAS-SCALE-Goldeye/25.10.7/TrueNAS-SCALE-25.10.7.iso",
        "sha256": "54ce9441ce66966a392e28f63604ca3c2c083d0bec4db7bb5af2f74f7a007c8e"
      }
    },
    {
      "id": "pop-os",
      "group": "desktop",
      "version": "24.04-build-28",
      "destination": "images/04-desktop/pop-os-24.04-generic-build-28.iso",
      "menu_alias": "Pop!_OS 24.04 한국어 설치",
      "description_ko": "원본 generic ISO를 사용하며 설치 첫 화면에서 한국어를 선택한다.",
      "description_en": "Unmodified generic ISO; select Korean or another language in the installer.",
      "boot_behavior": "interactive-installer",
      "profile_adapter": "none",
      "source": {
        "kind": "locked-download",
        "filename": "pop-os_24.04_amd64_generic_28.iso",
        "url": "https://iso.pop-os.org/24.04/amd64/generic/28/pop-os_24.04_amd64_generic_28.iso",
        "sha256": "8d78e500fc95da765a91cddcf2ab7ba71ce4e7997e4f008456d4d872ee8f8221"
      }
    },
    {
      "id": "debian-live",
      "group": "tools",
      "version": "13.7.0",
      "destination": "images/90-tools/debian-live-13.7.0.iso",
      "menu_alias": "Debian Live 13.7.0 장비 점검",
      "description_ko": "설치 전 인벤토리 확인과 비파괴 복구에 사용하는 라이브 환경이다.",
      "description_en": "Live environment for inventory capture and non-destructive recovery.",
      "boot_behavior": "live-environment",
      "profile_adapter": "none",
      "source": {
        "kind": "locked-download",
        "filename": "debian-live-13.7.0-amd64-standard.iso",
        "url": "https://cdimage.debian.org/debian-cd/13.7.0-live/amd64/iso-hybrid/debian-live-13.7.0-amd64-standard.iso",
        "sha256": "040a44f35186321eb6cdaab52a8a2d06224fe6b77f6fbb9f1861ad89c14e17ec"
      }
    }
  ],
  "bundles": [
    {
      "id": "pop-os-korean-guide",
      "destination": "guides/POP_OS_KO.md",
      "source": { "kind": "repository-file", "path": "homelab-usb/guides/pop-os-ko.md" }
    },
    {
      "id": "dns-appliance-status-monitor",
      "destination": "tools/dns-appliance-status-monitor",
      "source": { "kind": "repository-tree", "path": "management/dns-appliance-status-monitor" }
    }
  ]
}
